<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>ExactFertilityGrowingZones</AssemblyName>
    <RootNamespace>ExactFertilityGrowingZones</RootNamespace>
    <Version>1.0.2</Version>
    <OutputPath>../Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/_/Source</PathMap>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <RimWorldPath Condition="'$(RimWorldPath)' == ''">$(RIMWORLD_PATH)</RimWorldPath>
    <HarmonyPath Condition="'$(HarmonyPath)' == '' and '$(HARMONY_DLL_PATH)' != ''">$(HARMONY_DLL_PATH)</HarmonyPath>
    <HarmonyPath Condition="'$(HarmonyPath)' == ''">$(RimWorldPath)/../../workshop/content/294100/2009463077/1.6/Assemblies/0Harmony.dll</HarmonyPath>
    <ManagedPath>$(RimWorldPath)/RimWorldWin64_Data/Managed</ManagedPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedPath)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedPath)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedPath)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ManagedPath)/Assembly-CSharp.dll')" Text="RimWorld DLL not found. Pass -p:RimWorldPath=... with the RimWorld 1.6 installation path." />
    <Error Condition="!Exists('$(HarmonyPath)')" Text="Harmony DLL not found. Pass -p:HarmonyPath=... with the Harmony 1.6 0Harmony.dll path." />
  </Target>
</Project>
